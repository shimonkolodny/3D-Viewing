{
  "manifest_version": 3,
  "name": "3D Viewing – Anaglyph for Web Video",
  "short_name": "3D Viewing",
  "version": "0.1.0",
  "description": "Turn any web video into red/cyan anaglyph 3D in real time. Depth is computed locally by the free 3D Viewing PC app; nothing leaves your computer.",
  "minimum_chrome_version": "110",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_title": "3D Viewing",
    "default_popup": "popup/popup.html",
    "default_icon": { "16": "icons/16.png", "48": "icons/48.png" }
  },
  "background": { "service_worker": "src/background.js" },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/content.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/h264-main.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/h264-flag.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "commands": {
    "toggle-3d": {
      "suggested_key": { "default": "Alt+Shift+3" },
      "description": "Turn 3D on/off"
    }
  }
}
